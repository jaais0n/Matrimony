{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "packageManager": "pnpm@10.30.0",
  "scripts": {
    "dev": "pnpm --filter @workspace/pentecostal-matrimony run dev",
    "dev:server": "pnpm --filter @workspace/api-server run dev",
    "build": "pnpm --filter @workspace/pentecostal-matrimony run build && node scripts/prepare-deploy.mjs",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck"
  },
  "private": true,
  "devDependencies": {
    "prettier": "^3.9.6",
    "typescript": "~5.9.3"
  }
}
