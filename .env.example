# ============================================================
# Pentecostal Matrimony — Environment Variables Template
# ============================================================
# Copy this file to .env.local (development) or set these as
# Vercel Environment Variables in your project dashboard.
# NEVER commit .env.local or any file containing real secrets.
# ============================================================

# --- Neon PostgreSQL (required) ---
# Connection string from your Neon project → Connection Details
DATABASE_URL=postgresql://neondb_owner:<password>@<host>/neondb?sslmode=require&channel_binding=require

# --- Admin API Protection (required for destructive operations) ---
# Used as X-Admin-Key header in admin delete/wipe calls.
# Set a long random string (e.g. openssl rand -hex 32).
# Set the SAME value as VITE_ADMIN_SECRET so the frontend can send it.
ADMIN_SECRET=change-me-to-a-long-random-secret

# --- Vite public env (prefixed with VITE_ to be embedded in the frontend bundle) ---
# This is the admin key the browser sends as X-Admin-Key when deleting via /admin.
VITE_ADMIN_SECRET=change-me-to-a-long-random-secret

# --- Firebase Realtime Database (optional, for messaging) ---
# VITE_FIREBASE_DATABASE_URL=https://your-project.firebaseio.com

# --- Clerk Authentication (optional, future use) ---
# VITE_CLERK_PUBLISHABLE_KEY=pk_live_...
